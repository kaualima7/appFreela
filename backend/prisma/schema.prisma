// Define as tabelas e as relações do banco SQLite usado pelo Freelike.
// Os serviços em backend/src usam essas estruturas por meio do Prisma.

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum AccountType {
  FREELANCER
  CLIENT
}

// Conta usada para entrar no sistema; accountType diferencia cliente e freelancer.
model User {
  id             Int               @id @default(autoincrement())
  name           String
  email          String            @unique
  passwordHash   String
  createdAt      DateTime          @default(now())
  profile        Profile?
  accountType    AccountType       @default(FREELANCER)
  specialties    Json              @default("[]")
  clients        Client[]          @relation("FreelancerContacts")
  linkedContacts Client[]          @relation("ClientAccount")
  services       Service[]
  interests      ServiceInterest[]
}

// Dados complementares de uma conta; userId é único, permitindo um perfil por usuário.
model Profile {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int       @unique
  fullName  String
  birthDate DateTime?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Contato da agenda do freelancer: userId é o dono e clientUserId é a conta de cliente vinculada.
model Client {
  id           Int       @id @default(autoincrement())
  name         String
  email        String?
  phone        String?
  company      String?
  notes        String?
  user         User      @relation("FreelancerContacts", fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  clientUser   User?     @relation("ClientAccount", fields: [clientUserId], references: [id], onDelete: SetNull)
  clientUserId Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]

  @@index([clientUserId])
}

// Anúncio de serviço do freelancer; published controla sua exibição na vitrine.
model Service {
  id            Int               @id @default(autoincrement())
  freelancer    User              @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  freelancerId  Int
  title         String
  description   String
  category      String
  startingPrice Decimal
  imageUrl      String?
  published     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  interests     ServiceInterest[]

  @@index([freelancerId])
  @@index([published, category])
}

// Like de uma conta de cliente em um anúncio; a combinação dos dois IDs não pode se repetir.
model ServiceInterest {
  id           Int      @id @default(autoincrement())
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId    Int
  clientUser   User     @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  clientUserId Int
  createdAt    DateTime @default(now())

  @@unique([serviceId, clientUserId])
  @@index([clientUserId])
}

// Trabalho ligado a um contato; value é o valor combinado e payments reúne seus registros de pagamento.
model Project {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  status      String    @default("PLANNED")
  startDate   DateTime  @default(now())
  deadline    DateTime?
  value       Decimal
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]
}

// Parcela ou recebimento ligado a um projeto; status e paidAt indicam se já foi recebido.
model Payment {
  id            Int       @id @default(autoincrement())
  amount        Decimal
  dueDate       DateTime
  paidAt        DateTime?
  paymentMethod String?
  status        String    @default("PENDING")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
